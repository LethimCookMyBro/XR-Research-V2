  "steps": [
    {
      "text_en": "<size=24><color=#5B6B7F>Start</color></size>\n<size=46><b>Look at the fan from the front</b></size>\n\n<size=34><color=#4A5A6E>Areas to check: front guard, blade, rear guard · do not open the motor</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Find what is loose · any order</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Check</color></size>\n<size=46><b>Select “Examine” on the task panel</b></size>\n\n<size=34><color=#4A5A6E>Read one line at a time</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Normal: front guard aligned, clip closed · rear rim does not move</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Open</color></size>\n<size=46><b>Release the clip, turn the front guard, pull it off</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Blade is visible</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Check</color></size>\n<size=46><b>Select “Examine” again, read the blade line</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Normal: fully seated, no movement</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Open</color></size>\n<size=46><b>Loosen the blade cap: turn clockwise</b></size>\n\n<size=34><color=#9A5B00>⚠ Viewed from the front of the fan · This one turns the opposite way to normal</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Cap comes off</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Open</color></size>\n<size=46><b>Pull the blade off along the shaft</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Rear locking ring is visible</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Check</color></size>\n<size=46><b>Select “Examine” again, read the rear guard line</b></size>\n\n<size=34><color=#4A5A6E>Threaded on does not mean tight</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Normal: rim does not move</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>If the rear guard moves</color></size>\n<size=46><b>Tighten the ring clockwise until it stops</b></size>\n\n<size=34><color=#4A5A6E>Viewed from the front of the fan · To realign the guard, loosen the ring off first</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Rear guard rim does not move</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Reassemble</color></size>\n<size=46><b>Push the blade back fully</b></size>\n\n<size=34><color=#4A5A6E>The slot must be on the pin</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Blade does not wobble</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Reassemble</color></size>\n<size=46><b>Fit the cap, turn counter-clockwise until it stops</b></size>\n\n<size=34><color=#9A5B00>⚠ Viewed from the front of the fan · Opposite direction to the rear ring</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Cap is tight</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Reassemble</color></size>\n<size=46><b>Fit the front guard, turn to lock, close the clip</b></size>\n\n<size=34><color=#4A5A6E>Marks must align · all guards on before inspecting</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Clip closed</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Inspect</color></size>\n<size=46><b>Select “Inspect”</b></size>\n\n<size=34><color=#4A5A6E>The fan runs 3 seconds · listen</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> “Inspection passed · Ready for use.” = done</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>If not passed</color></size>\n<size=46><b>Read the result and fix</b></size>\n\n<size=34><color=#4A5A6E>“Test pending” = parts missing · “Abnormal noise is still detected.” = still something loose</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Fix, then select “Inspect” again · system fault: tell the researcher</color></size>"
    }
  ],
