  "steps": [
    {
      "text_en": "<size=24><color=#5B6B7F>Start</color></size>\n<size=46><b>Look at the empty slots</b></size>\n\n<size=34><color=#4A5A6E>Install RAM ×2 · SSD ×1 · GPU ×1 · do not remove CPU/PSU</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> You know what to install · any order</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Pick 2 RAM modules</b></size>\n\n<size=34><color=#4A5A6E>DDR4 · 8 GB each · identical · fitting does not mean right</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Both labels match W2</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Open the latch on slot A2</b></size>\n\n<size=34><color=#4A5A6E>The latch is on one side only</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Latch is open</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Press the RAM straight down until fully in</b></size>\n\n<size=34><color=#4A5A6E>Line up the notch · half in does not count</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Latch closes by itself</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Install the second module in slot B2</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> RAM in A2 and B2</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Pick 1 SSD</b></size>\n\n<size=34><color=#4A5A6E>SATA 2.5-inch · at least 500 GB and 600 TBW · TBW is not capacity</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Type and both values meet W2</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Hold the stand handle and turn the case to the back</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> SSD tray slot is visible</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Push the SSD tray fully in</b></size>\n\n<size=34><color=#4A5A6E>No screw under the SSD</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Tray is in place</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Tighten the tray fastener</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Tray does not move</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Plug in the SATA data cable</b></size>\n\n<size=34><color=#4A5A6E>Cables do not connect by themselves</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Fully plugged in</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Plug in the SATA power cable</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> SSD has both cables</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Pick 1 graphics card</b></size>\n\n<size=34><color=#4A5A6E>VRAM 8 GB or more · 150 W or less (card power)</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Both values pass</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Push the card fully into the primary slot</b></size>\n\n<size=34><color=#4A5A6E>Primary = the long slot wired to the CPU</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Card contacts fully in the slot</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Tighten the bracket screw</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Screw is tight</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Plug the 8-pin power into the card</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Plug fully in</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Inspect</color></size>\n<size=46><b>Select “Inspect”</b></size>\n\n<size=34><color=#4A5A6E>Wait 3 seconds</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> “Inspection passed · W2 requirements met.” = done</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>If not passed</color></size>\n<size=46><b>Read the result and fix</b></size>\n\n<size=34><color=#4A5A6E>“Assembly or connections are incomplete.” = not fully in / not fastened / no cable · “W2 requirements are not met yet.” = wrong part or slot · To remove: latch, cable or screw first</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Fix, then select “Inspect” again · system fault: tell the researcher</color></size>"
    }
  ],
