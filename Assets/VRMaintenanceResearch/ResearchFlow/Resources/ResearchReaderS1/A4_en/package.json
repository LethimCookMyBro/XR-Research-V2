  "steps": [
    {
      "text_en": "<size=24><color=#5B6B7F>Assemble computer W2</color></size>\n<size=46><b>Fit RAM, SSD and GPU that meet W2 requirements.</b></size>\n\n<size=34>Grip: hold large parts/stand, move, release.\nTrigger: hold latches/screws/plugs, move, release; press for Main.</size>\n\n<size=34><color=#2E7D32>Check my work, wait 3 seconds. A W2-passed result means done.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Start</color></size>\n<size=46><b>Find the RAM, SSD and GPU positions</b></size>\n\n<size=34><color=#4A5A6E>Power off. Keep CPU/cooler/PSU/cables. No OS or cover.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Any order. Not every bench part is needed.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Read labels; choose two RAM modules</b></size>\n\n<size=34><color=#4A5A6E>Identical DDR4, 8 GB each, 16 GB total.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Every value matches; fitting is not enough.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Open the A2 latch</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> One side opens; the other is fixed.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Align the RAM notch and press straight down</b></size>\n\n<size=34><color=#4A5A6E>Half-inserted is not connected.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> The latch closes itself when fully seated.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>RAM</color></size>\n<size=46><b>Fit the other module in B2</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> RAM is in A2 and B2.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Read labels; choose one SSD</b></size>\n\n<size=34><color=#4A5A6E>SATA 2.5-inch, ≥500 GB and ≥600 TBW.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Both values pass. TBW is not capacity.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Turn the case using the stand handle</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> The SSD tray mount behind the board is visible.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Push the SSD tray fully in</b></size>\n\n<size=34><color=#4A5A6E>SSD is already on the tray. No underside screws.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> The tray is seated.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Tighten the tray fastener</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> The tray does not move.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Insert the SATA data plug</b></size>\n\n<size=34><color=#4A5A6E>Seating the tray does not connect cables.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> The plug is fully in.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>SSD</color></size>\n<size=46><b>Insert the SATA power plug</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Both SSD cables are connected.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Read labels; choose one GPU</b></size>\n\n<size=34><color=#4A5A6E>VRAM ≥8 GB; card power ≤150 W.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Both values pass. Use card power, not PSU power.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Press the GPU fully into the primary slot</b></size>\n\n<size=34><color=#4A5A6E>The long slot wired to the CPU.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> The contacts are fully seated.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Tighten the GPU bracket screw</b></size>\n\n<size=34><color=#2E7D32><b>✓</b> Tight. Insertion alone does not secure it.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>GPU</color></size>\n<size=46><b>Insert PCIe 8-pin power into the GPU</b></size>\n\n<size=34><color=#4A5A6E>The 6+2 plug is already joined.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> The plug is fully in.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>Check my work</color></size>\n<size=46><b>Select Check my work on Main</b></size>\n\n<size=34><color=#4A5A6E>Wait 3 seconds.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> W2 passed means done.</color></size>"
    },
    {
      "text_en": "<size=24><color=#5B6B7F>If not passed</color></size>\n<size=46><b>Read the result, correct and retry</b></size>\n\n<size=34><color=#4A5A6E>Incomplete: seating/fastener/cable. W2 failure: part/slot.</color></size>\n\n<size=34><color=#2E7D32><b>✓</b> Before removal, release latch/cable/screw. System fault: tell researcher.</color></size>"
    }
  ],
