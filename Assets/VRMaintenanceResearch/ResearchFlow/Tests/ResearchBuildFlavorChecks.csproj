<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>RESEARCH_BUILD_FLAVOR_CHECKS</DefineConstants>
    <DefineConstants Condition="'$(DevFlavor)' == 'true'">$(DefineConstants);RESEARCH_DEV_READER_PROTOTYPE</DefineConstants>
    <ResearchFlowRoot Condition="'$(ResearchFlowRoot)' == ''">..</ResearchFlowRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ResearchFlowRoot)/Core/*.cs" Exclude="$(ResearchFlowRoot)/Core/ResearchMovementCollection.cs;$(ResearchFlowRoot)/Core/ResearchS1CablePath.cs;$(ResearchFlowRoot)/Core/ResearchS1FanObservations.cs" />
    <Compile Include="ResearchBuildFlavorChecks.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(ResearchFlowRoot)/../../../Library/PackageCache/com.unity.nuget.newtonsoft-json@4dfd81071c64/Runtime/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
