<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>RESEARCH_S1_FAN_OBSERVATION_CHECKS</DefineConstants>
    <ResearchFlowRoot Condition="'$(ResearchFlowRoot)' == ''">..</ResearchFlowRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ResearchS1FanObservationChecks.cs" />
    <Compile Include="../Core/ResearchS1FanObservations.cs" />
    <Compile Include="$(ResearchFlowRoot)/Core/ResearchS1TaskState.cs" />
    <Compile Include="$(ResearchFlowRoot)/Core/ResearchSessionFlow.cs" />
    <Compile Include="$(ResearchFlowRoot)/UI/ResearchStrings.cs" />
  </ItemGroup>
</Project>
