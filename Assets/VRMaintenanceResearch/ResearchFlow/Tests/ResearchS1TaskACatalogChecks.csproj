<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><IntermediateOutputPath>obj/$(MSBuildProjectName)/$(Configuration)/</IntermediateOutputPath><OutputPath>bin/$(MSBuildProjectName)/$(Configuration)/</OutputPath>
    <DefineConstants>RESEARCH_S1_TASK_A_CHECKS</DefineConstants>
    <CoreStateSource Condition="'$(CoreStateSource)' == ''">../Core/ResearchS1TaskState.cs</CoreStateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/ResearchS1TaskACatalog.cs" />
    <Compile Include="ResearchS1TaskACatalogChecks.cs" />
    <Compile Include="$(CoreStateSource)" />
  </ItemGroup>
</Project>
