    <ResearchFlowRoot Condition="'$(ResearchFlowRoot)' == ''">..</ResearchFlowRoot>
    <PortSource Condition="'$(PortSource)' == ''">$(ResearchFlowRoot)/Runtime/ResearchTaskPort.cs</PortSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PortSource)" />
    <Compile Include="$(ResearchFlowRoot)/Core/ResearchReferenceScheme.cs" />
    <Compile Include="$(ResearchFlowRoot)/Core/ResearchUIPolicy.cs" />
    <Compile Include="$(ResearchFlowRoot)/UI/ResearchDemoManual.cs" />
    <Compile Include="$(ResearchFlowRoot)/UI/ResearchStrings.cs" />
    <Compile Include="ResearchTaskSnapshotChecks.cs" />
  </ItemGroup>
</Project>
