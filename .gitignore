# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore

# A marker file of which existence is used to decide whether to run the first-launch experience or not.
InitCodeMarker
/[Tt]utorial [Dd]efaults/

# Packed templates go here
upm-ci~/
upm-ci.log

# Never ignore Asset meta data...
!/[Aa]ssets/**/*.meta

# User's project-specific settings implemented using Settings Manager
/ProjectSettings/Packages

# The rest are general best practices for Unity projects
/.Editor/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Vv]alidationSuiteResults/

# Project/user-specific settings using Settings Manager
/ProjectSettings/Packages/
# UserSettings introduced in 2020.1
/UserSettings/

# Uncomment this line if you wish to ignore the asset store tools plugin
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Rider
.idea/

# Visual Studio cache directory
.vs/

# Visual Studio Code settings directory and config
.vscode/
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
/.utmp/
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties
*.orig
*.orig.meta

# Ignore build reports
/Assets/BuildReports*

# Mac file setting
.DS_Store

# Format files
*.preformat.bak
*.preformat.bak.meta


# Private local data and generated caches (never publish in a source handoff)
__pycache__/
*.py[cod]
/ProfilerCaptures/
/ResearchData/
/Recordings/
/Transcripts/
/Assets/_Recovery/
/Assets/_Recovery.meta
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pfx

# Local-only legacy demo fixtures: redistribution rights are not confirmed.
/Assets/VRMaintenanceResearch/ResearchFlow/Editor/ReaderDemoFixtures/
/Assets/VRMaintenanceResearch/ResearchFlow/Editor/ReaderDemoFixtures.meta
/Assets/VRMaintenanceResearch/ResearchFlow/Editor/Resources/ResearchReaderDemo/
/Assets/VRMaintenanceResearch/ResearchFlow/Editor/Resources/ResearchReaderDemo.meta
# Raw font source is a local dependency; generated SDF assets remain in the project.
/Assets/VRMaintenanceResearch/ResearchFlow/UI/Fonts/NotoSansJP-Regular.otf
/Assets/VRMaintenanceResearch/ResearchFlow/UI/Fonts/NotoSansJP-Regular.otf.meta

# Cross-PC sync: machine-local / generated
/.claude/
/.cursor/
*.slnx
/Assets/VRMaintenanceResearch/AuditOutputs/

# Hand-written test projects under Assets (used by Run-*Checks.ps1); their .meta files are tracked
!/Assets/VRMaintenanceResearch/**/Tests/*.csproj
